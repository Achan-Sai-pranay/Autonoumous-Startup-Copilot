#.env
# Copy this file to "backend/.env" and paste your real keys below.
# All 3 providers offer generous 100% free tiers:
#
# 1. Google Gemini (Chief Judge & 12 Blueprint Agents)
#    Get free API key: https://aistudio.google.com/app/apikey
#    Supports comma-separated keys for auto round-robin scaling:
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud (AI 1 — The Bull Partner: Llama 3.3 70B Versatile)
#    Get free API key: https://console.groq.com/keys
#    (Optional: falls back to Gemini if omitted)
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter (AI 2 — The Bear Partner: DeepSeek V3 / Llama 3.3 70B Free)
#    Get free API key: https://openrouter.ai/keys
#    (Optional: falls back to Groq / Gemini if omitted)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Scaling tip: You can provide multiple comma-separated keys for any provider
# to multiply your free quota (e.g. GEMINI_API_KEY=key1,key2,key3).

# 4. Razorpay Payment Gateway (UPI QR, Cards, Netbanking)
#    Get test/live keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Port the backend server runs on (defaults to 5001 to avoid conflicts)
PORT=5001